+
+// warsmash-nx (round 5): the objects made since the last collection, gathered from the threads'
+// lists and sorted by address while a collection runs (runGC only; it runs one at a time).
+static std::vector<jobject> youngSorted;
+static std::vector<jobject> youngScratch;
+
+// LSD radix sort of object addresses, 11 bits a pass over (address - lowest): ~3 passes for a
+// heap of a few GB, linear in the count, where std::sort of a million pointers is ~10x slower.
+static void sortObjectAddresses(std::vector<jobject> &v, std::vector<jobject> &scratch) {
+    const size_t n = v.size();
+    if (n < 4096) {
+        std::sort(v.begin(), v.end());
+        return;
+    }
+    uintptr_t lowest = UINTPTR_MAX, highest = 0;
+    for (auto object : v) {
+        const auto address = (uintptr_t) object;
+        if (address < lowest) lowest = address;
+        if (address > highest) highest = address;
+    }
+    const uintptr_t span = highest - lowest;
+    static size_t counts[2048];
+    scratch.resize(n);
+    jobject *from = v.data(), *to = scratch.data();
+    for (unsigned shift = 0; shift < sizeof(uintptr_t) * 8 && (span >> shift) != 0; shift += 11) {
+        memset(counts, 0, sizeof counts);
+        for (size_t i = 0; i < n; i++)
+            counts[(((uintptr_t) from[i] - lowest) >> shift) & 2047]++;
+        size_t sum = 0;
+        for (auto &count : counts) {
+            const size_t c = count;
+            count = sum;
+            sum += c;
+        }
+        for (size_t i = 0; i < n; i++)
+            to[counts[(((uintptr_t) from[i] - lowest) >> shift) & 2047]++] = from[i];
+        std::swap(from, to);
+    }
+    if (from != v.data())
+        memcpy(v.data(), from, n * sizeof(jobject));
+}
+
+static bool isYoungObject(jobject object) {
+    return std::binary_search(youngSorted.begin(), youngSorted.end(), object);
+}
