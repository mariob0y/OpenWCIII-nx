From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mariob0y <suroviymarioboy@gmail.com>
Date: Mon, 23 Nov 2026 16:51:54 +0200
Subject: [PATCH] perf: runtime - ArrayList iterates its array directly

---
 runtime/src/java/util/ArrayList.java | 47 ++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/runtime/src/java/util/ArrayList.java b/runtime/src/java/util/ArrayList.java
index 3e423b0..e117e92 100644
--- a/runtime/src/java/util/ArrayList.java
+++ b/runtime/src/java/util/ArrayList.java
@@ -590,6 +590,53 @@ public class ArrayList<E> extends AbstractList<E> implements List<E>, RandomAcce
         return size;
     }
 
+    /**
+     * An iterator straight over the backing array, as the JDK's own ArrayList has. The inherited
+     * AbstractList iterator called the virtual size() and get() (with its bounds check) for every
+     * element inside a try block; on the Switch 2 that made every for-each over a list one of the
+     * game's hottest spots (13.8% of the game thread, 2026-11-23).
+     */
+    @Override
+    public Iterator<E> iterator() {
+        return new Itr();
+    }
+
+    private final class Itr implements Iterator<E> {
+        private int cursor;
+        private int lastReturned = -1;
+        private int expectedModCount = modCount;
+
+        public boolean hasNext() {
+            return cursor != size;
+        }
+
+        public E next() {
+            if (modCount != expectedModCount) {
+                throw new ConcurrentModificationException();
+            }
+            final int i = cursor;
+            if (i >= size) {
+                throw new NoSuchElementException();
+            }
+            cursor = i + 1;
+            lastReturned = i;
+            return array[firstIndex + i];
+        }
+
+        public void remove() {
+            if (lastReturned < 0) {
+                throw new IllegalStateException();
+            }
+            if (modCount != expectedModCount) {
+                throw new ConcurrentModificationException();
+            }
+            ArrayList.this.remove(lastReturned);
+            cursor = lastReturned;
+            lastReturned = -1;
+            expectedModCount = modCount;
+        }
+    }
+
     /**
      * Returns a shallow copy of this <tt>ArrayList</tt> instance.  (The
      * elements themselves are not copied.)
