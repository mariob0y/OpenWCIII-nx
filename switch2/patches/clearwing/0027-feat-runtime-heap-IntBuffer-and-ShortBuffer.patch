diff --git a/runtime/src/java/nio/HeapIntBuffer.java b/runtime/src/java/nio/HeapIntBuffer.java
new file mode 100644
index 0000000..3d09bbb
--- /dev/null
+++ b/runtime/src/java/nio/HeapIntBuffer.java
@@ -0,0 +1,112 @@
+package java.nio;
+
+/**
+ * warsmash-nx (jdk3c): a Int buffer backed by a int[], as the JDK's HeapIntBuffer (and its
+ * read-only variant, through the isReadOnly field). Its address is the array's data + offset, so
+ * natives that read at address + position also work on it.
+ */
+class HeapIntBuffer extends IntBuffer {
+
+	HeapIntBuffer (int cap, int lim) {
+		this(new int[cap], -1, 0, lim, cap, 0);
+	}
+
+	HeapIntBuffer (int[] buf, int off, int len) {
+		this(buf, -1, off, off + len, buf.length, 0);
+	}
+
+	HeapIntBuffer (int[] buf, int mark, int pos, int lim, int cap, int off) {
+		super(mark, pos, lim, cap, buf, off);
+		this.address = NativeUtils.getArrayAddress(buf) + (long) off * 4;
+	}
+
+	private HeapIntBuffer copy (int mark, int pos, int lim, int cap, int off) {
+		HeapIntBuffer b = new HeapIntBuffer(hb, mark, pos, lim, cap, off);
+		b.isReadOnly = isReadOnly;
+		return b;
+	}
+
+	private void writable () {
+		if (isReadOnly)
+			throw new ReadOnlyBufferException();
+	}
+
+	public IntBuffer slice () {
+		int rem = this.remaining();
+		return copy(-1, 0, rem, rem, this.position() + offset);
+	}
+
+	public IntBuffer duplicate () {
+		return copy(this.markValue(), this.position(), this.limit(), this.capacity(), offset);
+	}
+
+	public IntBuffer asReadOnlyBuffer () {
+		HeapIntBuffer b = new HeapIntBuffer(hb, this.markValue(), this.position(), this.limit(), this.capacity(), offset);
+		b.isReadOnly = true;
+		return b;
+	}
+
+	protected int ix (int i) {
+		return i + offset;
+	}
+
+	public int get () {
+		return hb[ix(nextGetIndex())];
+	}
+
+	public int get (int i) {
+		return hb[ix(checkIndex(i))];
+	}
+
+	public IntBuffer get (int[] dst, int offset, int length) {
+		checkBounds(offset, length, dst.length);
+		if (length > remaining())
+			throw new BufferUnderflowException();
+		System.arraycopy(hb, ix(position()), dst, offset, length);
+		position(position() + length);
+		return this;
+	}
+
+	public boolean isDirect () {
+		return false;
+	}
+
+	public boolean isReadOnly () {
+		return isReadOnly;
+	}
+
+	public IntBuffer put (int x) {
+		writable();
+		hb[ix(nextPutIndex())] = x;
+		return this;
+	}
+
+	public IntBuffer put (int i, int x) {
+		writable();
+		hb[ix(checkIndex(i))] = x;
+		return this;
+	}
+
+	public IntBuffer put (int[] src, int offset, int length) {
+		writable();
+		checkBounds(offset, length, src.length);
+		if (length > remaining())
+			throw new BufferOverflowException();
+		System.arraycopy(src, offset, hb, ix(position()), length);
+		position(position() + length);
+		return this;
+	}
+
+	public IntBuffer compact () {
+		writable();
+		System.arraycopy(hb, ix(position()), hb, ix(0), remaining());
+		position(remaining());
+		limit(capacity());
+		discardMark();
+		return this;
+	}
+
+	public ByteOrder order () {
+		return ByteOrder.nativeOrder();
+	}
+}
