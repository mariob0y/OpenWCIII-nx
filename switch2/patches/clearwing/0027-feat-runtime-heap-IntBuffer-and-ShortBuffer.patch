+package java.nio;
+
+/**
+ * warsmash-nx (jdk3c): a Short buffer backed by a short[], as the JDK's HeapShortBuffer (and its
+ * read-only variant, through the isReadOnly field). Its address is the array's data + offset, so
+ * natives that read at address + position also work on it.
+ */
+class HeapShortBuffer extends ShortBuffer {
+
+	HeapShortBuffer (int cap, int lim) {
+		this(new short[cap], -1, 0, lim, cap, 0);
+	}
+
+	HeapShortBuffer (short[] buf, int off, int len) {
+		this(buf, -1, off, off + len, buf.length, 0);
+	}
+
+	HeapShortBuffer (short[] buf, int mark, int pos, int lim, int cap, int off) {
+		super(mark, pos, lim, cap, buf, off);
+		this.address = NativeUtils.getArrayAddress(buf) + (long) off * 2;
+	}
+
+	private HeapShortBuffer copy (int mark, int pos, int lim, int cap, int off) {
+		HeapShortBuffer b = new HeapShortBuffer(hb, mark, pos, lim, cap, off);
+		b.isReadOnly = isReadOnly;
+		return b;
+	}
+
+	private void writable () {
+		if (isReadOnly)
+			throw new ReadOnlyBufferException();
+	}
+
+	public ShortBuffer slice () {
+		int rem = this.remaining();
+		return copy(-1, 0, rem, rem, this.position() + offset);
+	}
+
+	public ShortBuffer duplicate () {
+		return copy(this.markValue(), this.position(), this.limit(), this.capacity(), offset);
+	}
+
+	public ShortBuffer asReadOnlyBuffer () {
+		HeapShortBuffer b = new HeapShortBuffer(hb, this.markValue(), this.position(), this.limit(), this.capacity(), offset);
+		b.isReadOnly = true;
+		return b;
+	}
+
+	protected int ix (int i) {
+		return i + offset;
+	}
+
+	public short get () {
+		return hb[ix(nextGetIndex())];
+	}
+
+	public short get (int i) {
+		return hb[ix(checkIndex(i))];
+	}
+
+	public ShortBuffer get (short[] dst, int offset, int length) {
+		checkBounds(offset, length, dst.length);
+		if (length > remaining())
+			throw new BufferUnderflowException();
+		System.arraycopy(hb, ix(position()), dst, offset, length);
+		position(position() + length);
+		return this;
+	}
+
+	public boolean isDirect () {
+		return false;
+	}
+
+	public boolean isReadOnly () {
+		return isReadOnly;
+	}
+
+	public ShortBuffer put (short x) {
+		writable();
+		hb[ix(nextPutIndex())] = x;
+		return this;
+	}
+
+	public ShortBuffer put (int i, short x) {
+		writable();
+		hb[ix(checkIndex(i))] = x;
+		return this;
+	}
+
+	public ShortBuffer put (short[] src, int offset, int length) {
+		writable();
+		checkBounds(offset, length, src.length);
+		if (length > remaining())
+			throw new BufferOverflowException();
+		System.arraycopy(src, offset, hb, ix(position()), length);
+		position(position() + length);
+		return this;
+	}
+
+	public ShortBuffer compact () {
+		writable();
+		System.arraycopy(hb, ix(position()), hb, ix(0), remaining());
+		position(remaining());
+		limit(capacity());
+		discardMark();
+		return this;
+	}
+
+	public ByteOrder order () {
+		return ByteOrder.nativeOrder();
+	}
+}
diff --git a/runtime/src/java/nio/IntBuffer.java b/runtime/src/java/nio/IntBuffer.java
index 079f379..75ba895 100644
--- a/runtime/src/java/nio/IntBuffer.java
+++ b/runtime/src/java/nio/IntBuffer.java
@@ -256,7 +256,10 @@ public abstract class IntBuffer extends Buffer implements Comparable<IntBuffer>
 	 * @throws IllegalArgumentException If the <tt>capacity</tt> is a negative integer
 	 */
 	public static IntBuffer allocate (int capacity) {
-		return ByteBuffer.allocate(capacity * 4).asIntBuffer();
+		// warsmash-nx (jdk3c): a heap buffer, as the JDK (was a view over a ByteBuffer: no array())
+		if (capacity < 0)
+			throw new IllegalArgumentException("capacity < 0: (" + capacity + " < 0)");
+		return new HeapIntBuffer(capacity, capacity);
 	}
 
 	/**
@@ -283,7 +286,9 @@ public abstract class IntBuffer extends Buffer implements Comparable<IntBuffer>
 	 *                                   parameters do not hold
 	 */
 	public static IntBuffer wrap (int[] array, int offset, int length) {
-		throw new UnsupportedOperationException();
+		// warsmash-nx (jdk3c): was a stub
+		checkBounds(offset, length, array.length);
+		return new HeapIntBuffer(array, offset, length);
 	}
 
 	/**
