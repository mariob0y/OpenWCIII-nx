         monitorEnter(ctx, (jobject) thread);
         thread->F_alive = false;
-        auto monitor = (jmonitor) ((jobject) thread)->monitor;
+        auto monitor = getMonitor((jobject) thread); // warsmash-nx
         { std::lock_guard<std::mutex> lock(monitor->conditionMutex); }
         monitor->condition.notify_all();
         monitorExit(ctx, (jobject) thread);
@@ -95,7 +95,7 @@ void M_java_lang_Thread_interrupt(jcontext ctx, jobject self) {
     threadCtx->lock.lock();
     threadCtx->thread->F_interrupted = true;
     if (threadCtx->blockedBy)
-        ((jmonitor) ((jobject) threadCtx->blockedBy)->monitor)->condition.notify_all();
+        getMonitor((jobject) threadCtx->blockedBy)->condition.notify_all(); // warsmash-nx
     threadCtx->lock.unlock();
 }
 
diff --git a/transpiler/src/com/thelogicmaster/clearwing/bytecode/JumpingInstruction.java b/transpiler/src/com/thelogicmaster/clearwing/bytecode/JumpingInstruction.java
