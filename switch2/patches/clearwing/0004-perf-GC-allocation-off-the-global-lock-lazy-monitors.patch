diff --git a/runtime/res/clearwing/src/Clearwing.h b/runtime/res/clearwing/src/Clearwing.h
index 4d6f86a..4078872 100644
--- a/runtime/res/clearwing/src/Clearwing.h
+++ b/runtime/res/clearwing/src/Clearwing.h
@@ -291,6 +291,7 @@ NORETURN void throwIndexOutOfBounds(jcontext ctx);
 NORETURN void throwArrayIndexOutOfBounds(jcontext ctx); // warsmash-nx
 NORETURN void throwNegativeArraySize(jcontext ctx); // warsmash-nx
 void clearwingPlaceThread(void); // warsmash-nx: PlatformThreads.cpp
+void clearwingRaiseThreadPriority(void); // warsmash-nx: PlatformThreads.cpp, for the collector
 
 // warsmash-nx: what the collector is doing, for a watchdog on another thread. Plain aligned
 // 64/32-bit stores and loads (atomic on AArch64); a reader may see fields of two moments.
@@ -917,6 +918,22 @@ struct ObjectMonitor {
     std::mutex conditionMutex;
 };
 
+// warsmash-nx: an object's monitor is made on first use (synchronized, wait, notify), not with the
+// object: almost no object is ever locked, and a monitor was an allocation and a free per object.
+// Two threads racing here agree through the compare-and-swap; the loser frees its copy.
+inline jmonitor getMonitor(jobject object) {
+    auto existing = (jmonitor) __atomic_load_n(&object->monitor, __ATOMIC_ACQUIRE);
+    if (existing)
+        return existing;
+    auto created = new ObjectMonitor;
+    jref expected = 0;
+    if (__atomic_compare_exchange_n(&object->monitor, &expected, (jref) created, false, __ATOMIC_ACQ_REL,
+                                    __ATOMIC_ACQUIRE))
+        return created;
+    delete created;
+    return (jmonitor) expected;
+}
+
 struct ExceptionFrame {
     jclass type;
     jmp_buf landingPad;
@@ -945,6 +962,7 @@ struct Context {
     std::atomic<jobject> blockedBy; // Object monitor blocking the current thread, or null
     bool dead{};
     std::vector<jobject> globalRefs{}; // Global JNI references
+    std::vector<jobject> youngObjects{}; // warsmash-nx: allocated since the last collection, not yet in `objects`
 };
 
 /// Checks if an object is null. Throws exceptions.
