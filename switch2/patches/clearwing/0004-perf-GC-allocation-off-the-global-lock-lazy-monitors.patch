diff --git a/runtime/res/clearwing/src/Clearwing.cpp b/runtime/res/clearwing/src/Clearwing.cpp
index 1a4e155..397c061 100644
--- a/runtime/res/clearwing/src/Clearwing.cpp
+++ b/runtime/res/clearwing/src/Clearwing.cpp
@@ -75,6 +75,9 @@ bool volatile suspendVM;
 
 ClearwingGcStats clearwingGcStats{}; // warsmash-nx
 
+void M_java_lang_Object_finalize(jcontext ctx, jobject self); // warsmash-nx: Object.cpp (empty)
