@@ -154,7 +157,7 @@ void shutdownVM(jcontext ctx) {
             done = false;
             threadContext->lock.lock();
             if (threadContext->blockedBy)
-                ((jmonitor) ((jobject) threadContext->blockedBy)->monitor)->condition.notify_all();
+                getMonitor((jobject) threadContext->blockedBy)->condition.notify_all(); // warsmash-nx
             threadContext->lock.unlock();
         }
         if (done)
@@ -398,6 +401,10 @@ jobject gcAllocObject(jcontext ctx, jclass clazz, int mark) {
         rootObjects = new ankerl::unordered_dense::set<jobject>;
     }
 
+    // warsmash-nx: an allocation is a safepoint. Without this a thread allocating while another
+    // collects returned from runGC (already running) and went on allocating, never stopping.
+    SAFEPOINT();
+
     if (heapUsage > GC_HEAP_THRESHOLD || heapUsage - lastCollectionHeapUsage > GC_MEM_THRESHOLD || allocationsSinceCollection > GC_OBJECT_THRESHOLD)
         runGC(ctx);
 
@@ -405,22 +412,25 @@ jobject gcAllocObject(jcontext ctx, jclass clazz, int mark) {
         constructAndThrow<&class_java_lang_OutOfMemoryError, init_java_lang_OutOfMemoryError>(ctx);
 
     auto object = (jobject) new char[clazz->size]{};
-    heapUsage += clazz->size + (int64_t) sizeof(ObjectMonitor);
+    heapUsage += clazz->size; // warsmash-nx: no monitor with the object any more
     allocationsSinceCollection++;
 
     *object = {
         .clazz = (intptr_t) clazz,
         .gcMark = mark,
         .vtable = (intptr_t) clazz->classVtable,
-        .monitor = (intptr_t) new ObjectMonitor,
+        .monitor = 0, // warsmash-nx: getMonitor makes it on first use
     };
 
-    objectsLock.lock();
+    // warsmash-nx: the thread's own list, no lock; runGC moves it into `objects` with every thread
+    // stopped (an allocation is never interrupted by a safepoint, so the list is never half-written).
     if (mark == GC_MARK_START)
-        objects->emplace(object);
-    else
+        ctx->youngObjects.push_back(object);
+    else {
+        objectsLock.lock();
         rootObjects->emplace(object);
-    objectsLock.unlock();
+        objectsLock.unlock();
+    }
 
     return object;
 }
@@ -514,6 +524,13 @@ jcontext createContext() {
 void destroyContext(jcontext context) {
     destroyJni(context->jniEnv);
     acquireCriticalLock();
+    if (!context->youngObjects.empty()) { // warsmash-nx: its last objects join the set (runGC holds criticalLock)
+        objectsLock.lock();
+        for (auto object : context->youngObjects)
+            objects->emplace(object);
+        objectsLock.unlock();
+        context->youngObjects.clear();
+    }
     std::erase(threadContexts, context);
     releaseCriticalLock();
     delete context;
@@ -524,6 +541,7 @@ static void collectionThreadFunc(jcontext ctx) {
 
     attachThread(ctx);
     clearwingPlaceThread(); // warsmash-nx: run beside the main thread, not starved behind it
+    clearwingRaiseThreadPriority(); // warsmash-nx: and never behind a Java thread on its core
 
     try {
         FrameInfo frameInfo{ "GC:collect", 0 };
@@ -543,9 +561,14 @@ static void collectionThreadFunc(jcontext ctx) {
                 clearwingGcStats.collectorPhase = 1;
                 int64_t done = 0;
                 for (jobject obj : collected) {
-                    tryCatch(frameRef, [&]{
-                        ((finalizer_ptr)((void **)obj->vtable)[VTABLE_java_lang_Object_finalize])(ctx, obj);
-                    }, &class_java_lang_Throwable, [](jobject ignored){});
+                    // warsmash-nx: the empty Object.finalize is not called; arrays' directly
+                    auto finalizer = (finalizer_ptr)((void **)obj->vtable)[VTABLE_java_lang_Object_finalize];
+                    if (finalizer == array_finalize)
+                        array_finalize(ctx, obj);
+                    else if (finalizer != M_java_lang_Object_finalize)
+                        tryCatch(frameRef, [&]{
+                            finalizer(ctx, obj);
+                        }, &class_java_lang_Throwable, [](jobject ignored){});
                     if ((++done & 4095) == 0) {
                         clearwingGcStats.collectorDone = done;
                         SAFEPOINT();
@@ -555,18 +578,18 @@ static void collectionThreadFunc(jcontext ctx) {
                 clearwingGcStats.collectorDone = 0;
                 clearwingGcStats.collectorPhase = 2;
                 done = 0;
+                int64_t freedBytes = 0;
                 for (jobject obj : collected) {
                     if ((++done & 4095) == 0) {
                         clearwingGcStats.collectorDone = done;
+                        heapUsage -= freedBytes; // warsmash-nx: one atomic update per 4096 objects
+                        freedBytes = 0;
                         SAFEPOINT();
                     }
-                    objectsLock.lock();
-                    objects->erase(obj);
-                    objectsLock.unlock();
+                    // warsmash-nx: already out of `objects` (runGC's sweep), so no lock here
+                    freedBytes += ((jclass) obj->clazz)->size;
 
-                    heapUsage -= ((jclass) obj->clazz)->size + (int64_t) sizeof(ObjectMonitor);
-
-                    delete (ObjectMonitor *) obj->monitor;
+                    delete (ObjectMonitor *) obj->monitor; // warsmash-nx: null unless it was used
 
                     memset(obj, 0, sizeof(java_lang_Object)); // Erase collected objects to make memory bugs easier to catch
                     obj->gcMark = GC_MARK_COLLECTED; // Set collected flag again
@@ -574,6 +597,7 @@ static void collectionThreadFunc(jcontext ctx) {
                     delete[] (char *) obj;
                 }
 
+                heapUsage -= freedBytes; // warsmash-nx
                 clearwingGcStats.freedTotal += (int64_t) collected.size(); // warsmash-nx
                 clearwingGcStats.collectorPhase = 0;
                 collected.clear();
@@ -637,6 +661,16 @@ void runGC(jcontext ctx) {
 
     acquireCriticalLock();
 
+    // warsmash-nx: every thread is stopped: their new objects join the set before marking (the
+    // stack scan asks the set whether a slot holds an object).
+    objectsLock.lock();
+    for (auto threadContext : threadContexts) {
+        for (auto object : threadContext->youngObjects)
+            objects->emplace(object);
+        threadContext->youngObjects.clear();
+    }
+    objectsLock.unlock();
+
     static jint mark;
     if (++mark > GC_MARK_END)
         mark = GC_MARK_START + 1;
@@ -700,19 +734,23 @@ void runGC(jcontext ctx) {
     clearwingGcStats.phase = 3; // warsmash-nx
     const size_t queuedBefore = collectedObjects.size();
 
-    // Collect unreachable objects
-    for (jobject obj : *objects) {
+    // Collect unreachable objects (warsmash-nx: and remove them from the set here, with every
+    // thread stopped, instead of one locked erase per object in the collector thread)
+    objectsLock.lock();
+    std::erase_if(*objects, [&](jobject obj) {
         if ((obj->gcMark > GC_MARK_COLLECTED && obj->gcMark < GC_MARK_START) || obj->gcMark == mark)
-            continue;
-        if (obj->gcMark == GC_MARK_COLLECTED) // warsmash-nx: already queued for the collector
-            continue;
+            return false;
+        if (obj->gcMark == GC_MARK_COLLECTED) // warsmash-nx: already queued (cannot happen now)
+            return true;
         obj->gcMark = GC_MARK_COLLECTED;
         collectedObjects.emplace_back(obj);
 
         // Update weak references
         for (auto[it, end] = weakReferences.equal_range(obj); it != end; ++it)
             it->second->F_ptr = 0; // Todo: Always updating weak references here rather than at finalization may be problematic in some cases for JNI
-    }
+        return true;
+    });
+    objectsLock.unlock();
 
 #if false // Todo: Use macro
     std::map<jclass, int> usage;
@@ -965,7 +1003,7 @@ NORETURN void throwRuntimeException(jcontext ctx, const char *message) {
 /// Lock on a monitor. Throws exceptions.
 void monitorEnter(jcontext ctx, jobject object) {
     NULL_CHECK(object);
-    auto monitor = (jmonitor) object->monitor;
+    auto monitor = getMonitor(object); // warsmash-nx: made on first use
 
     // Race condition here is fine, fall back to slower/blocking acquire
     if (monitor->lock.try_lock()) {
@@ -991,8 +1029,8 @@ void monitorEnter(jcontext ctx, jobject object) {
 /// Unlock on a monitor. Throws exceptions.
 void monitorExit(jcontext ctx, jobject object) {
     NULL_CHECK(object);
-    auto monitor = (jmonitor) object->monitor;
     monitorOwnerCheck(ctx, object);
+    auto monitor = getMonitor(object); // warsmash-nx: exists, the owner check passed
     if (--monitor->depth == 0)
         monitor->owner = nullptr;
     monitor->lock.unlock();
@@ -1000,8 +1038,8 @@ void monitorExit(jcontext ctx, jobject object) {
 
 /// Checks if the current thread owns a given monitor. Throws exceptions.
 void monitorOwnerCheck(jcontext ctx, jobject object) {
-    auto monitor = (jmonitor) object->monitor;
-    if (!monitor->owner or monitor->owner != ctx)
+    auto monitor = (jmonitor) object->monitor; // warsmash-nx: none yet = not owned
+    if (!monitor or !monitor->owner or monitor->owner != ctx)
