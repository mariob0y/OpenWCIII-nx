From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mariob0y <suroviymarioboy@gmail.com>
Date: Mon, 23 Nov 2026 09:01:56 +0200
Subject: [PATCH 30/32] fix: runtime - System.getProperty cache keyed by text,
 cached null stays null

---
 runtime/res/clearwing/src/System.cpp | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/runtime/res/clearwing/src/System.cpp b/runtime/res/clearwing/src/System.cpp
index 3ff967c..aace087 100644
--- a/runtime/res/clearwing/src/System.cpp
+++ b/runtime/res/clearwing/src/System.cpp
@@ -4,6 +4,9 @@
 
 #include <cstring>
 #include <chrono>
+#include <map>
+#include <mutex>
+#include <string>
 
 extern "C" {
 
@@ -39,18 +42,21 @@ void SM_java_lang_System_gc(jcontext ctx) {
 }
 
 jobject SM_java_lang_System_getProperty_java_lang_String_R_java_lang_String(jcontext ctx, jobject keyObj) {
-    static std::map<const char *, const char *> cache;
+    // warsmash-nx (round 8): keyed by the text, not by stringToNative's buffer address, and a
+    // cached null (an unset property) is returned as null instead of going to stringFromNative.
+    static std::map<std::string, const char *> cache;
     static std::mutex lock;
     auto key = stringToNative(ctx, (jstring) NULL_CHECK(keyObj));
     if (!strcmp(key, "java.runtime.name"))
         return (jobject) createStringLiteral(ctx, u8"Clearwing"_j);
     std::lock_guard guard(lock);
     auto it = cache.find(key);
+    const char *value;
     if (it != cache.end())
-        return (jobject) stringFromNative(ctx, it->second);
-    auto &entry = cache[key];
-    entry = getSystemProperty(key);
-    return entry ? (jobject) stringFromNative(ctx, entry) : nullptr;
+        value = it->second;
+    else
+        value = cache[key] = getSystemProperty(key);
+    return value ? (jobject) stringFromNative(ctx, value) : nullptr;
 }
 
 jint SM_java_lang_System_identityHashCode_java_lang_Object_R_int(jcontext ctx, jobject obj) {
