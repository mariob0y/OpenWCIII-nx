From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mariob0y <suroviymarioboy@gmail.com>
Date: Mon, 23 Nov 2026 09:01:54 +0200
Subject: [PATCH 25/32] fix: runtime - UUID.fromString; heap-backed
 ByteBuffer.allocate and wrap

---
 runtime/src/java/nio/ByteBuffer.java | 30 +++++++++++++++++++++-------
 runtime/src/java/util/UUID.java      | 30 +++++++++++++++++++++++++++-
 2 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/runtime/src/java/nio/ByteBuffer.java b/runtime/src/java/nio/ByteBuffer.java
index 4afa6c5..b05060a 100644
--- a/runtime/src/java/nio/ByteBuffer.java
+++ b/runtime/src/java/nio/ByteBuffer.java
@@ -36,7 +36,7 @@ public class ByteBuffer extends Buffer implements Comparable<ByteBuffer> {
 		this.owner = owner;
 		isOwner = false;
 		address = owner.address + off;
-		array = null;
+		array = owner.array; // warsmash-nx: was null (slices of wrapped buffers lost their array)
 	}
 
 	ByteBuffer (long address, int cap) {
@@ -66,12 +66,23 @@ public class ByteBuffer extends Buffer implements Comparable<ByteBuffer> {
 		}
 	}
 
+	/** warsmash-nx: as the JDK, a buffer backed by a new byte[] (was a direct buffer). */
 	public static ByteBuffer allocate (int capacity) {
-		return allocateDirect(capacity);
+		if (capacity < 0)
+			throw new IllegalArgumentException("capacity < 0: (" + capacity + " < 0)");
+		return wrap(new byte[capacity]);
 	}
 
+	/**
+	 * warsmash-nx: as the JDK, capacity array.length, position offset, limit offset + length,
+	 * arrayOffset 0 (was capacity length, position 0, the address moved by offset).
+	 */
 	public static ByteBuffer wrap (byte[] array, int offset, int length) {
-		return new ByteBuffer(NativeUtils.getArrayAddress(array) + offset, length, false, array);
+		checkBounds(offset, length, array.length);
+		ByteBuffer buffer = new ByteBuffer(NativeUtils.getArrayAddress(array), array.length, false, array);
+		buffer.limit(offset + length);
+		buffer.position(offset);
+		return buffer;
 	}
 
 	public static ByteBuffer wrap (byte[] array) {
@@ -176,16 +187,21 @@ public class ByteBuffer extends Buffer implements Comparable<ByteBuffer> {
 		return put(src, 0, src.length);
 	}
 
+	// warsmash-nx: buffers from allocate/wrap (and their slices) have their byte[], as the JDK.
 	public final boolean hasArray () {
-		return false;
+		return array != null;
 	}
 
 	public final byte[] array () {
-		throw new UnsupportedOperationException();
+		if (array == null)
+			throw new UnsupportedOperationException();
+		return array;
 	}
 
 	public final int arrayOffset () {
-		throw new UnsupportedOperationException();
+		if (array == null)
+			throw new UnsupportedOperationException();
+		return (int)(address - NativeUtils.getArrayAddress(array));
 	}
 
 	@Override
@@ -237,7 +253,7 @@ public class ByteBuffer extends Buffer implements Comparable<ByteBuffer> {
 	}
 
 	public boolean isDirect () {
-		return true;
+		return array == null; // warsmash-nx: was always true
 	}
 
 	public String toString () {
diff --git a/runtime/src/java/util/UUID.java b/runtime/src/java/util/UUID.java
index 83620b4..c0797ac 100644
--- a/runtime/src/java/util/UUID.java
+++ b/runtime/src/java/util/UUID.java
@@ -184,7 +184,35 @@ public final class UUID implements java.io.Serializable, Comparable<UUID> {
      *
      */
     public static UUID fromString(String name) {
-        throw new UnsupportedOperationException();
+        // warsmash-nx: JDK 17's algorithm (Long.parseLong over substrings instead of the JDK's
+        // CharSequence range overload, which this runtime lacks: same values and exceptions, only a
+        // NumberFormatException's message can differ).
+        int len = name.length();
+        if (len > 36) {
+            throw new IllegalArgumentException("UUID string too large");
+        }
+
+        int dash1 = name.indexOf('-', 0);
+        int dash2 = name.indexOf('-', dash1 + 1);
+        int dash3 = name.indexOf('-', dash2 + 1);
+        int dash4 = name.indexOf('-', dash3 + 1);
+        int dash5 = name.indexOf('-', dash4 + 1);
+
+        if (dash4 < 0 || dash5 >= 0) {
+            throw new IllegalArgumentException("Invalid UUID string: " + name);
+        }
+
+        long mostSigBits = Long.parseLong(name.substring(0, dash1), 16) & 0xffffffffL;
+        mostSigBits <<= 16;
+        mostSigBits |= Long.parseLong(name.substring(dash1 + 1, dash2), 16) & 0xffffL;
+        mostSigBits <<= 16;
+        mostSigBits |= Long.parseLong(name.substring(dash2 + 1, dash3), 16) & 0xffffL;
+        long leastSigBits = Long.parseLong(name.substring(dash3 + 1, dash4), 16) & 0xffffL;
+        leastSigBits <<= 48;
+        leastSigBits |= Long.parseLong(name.substring(dash4 + 1, len), 16) & 0xffffffffffffL;
+
+        return new UUID(mostSigBits, leastSigBits);
+        // Clearwing's commented-out Java 6 version, kept below:
 //        String[] components = name.split("-");
 //        if (components.length != 5)
 //            throw new IllegalArgumentException("Invalid UUID string: "+name);
