diff --git a/runtime/res/clearwing/src/PlatformThreads.cpp b/runtime/res/clearwing/src/PlatformThreads.cpp
new file mode 100644
index 0000000..00a1b05
--- /dev/null
+++ b/runtime/res/clearwing/src/PlatformThreads.cpp
@@ -0,0 +1,46 @@
+// warsmash-nx: where the runtime's own threads run on the Switch.
+//
+// libnx/libounce start every std::thread at priority 0x3B on the process's default core, below
+// the main thread (0x2C) on the same core. Horizon does not time-slice threads there, so while the
+// main thread computes, those threads never run: the GC thread (which frees what a collection
+// found dead) and every java.lang.Thread. Here each one takes the main thread's priority and a
+// core of its own where the process has one (round robin over the allowed cores other than the
+// main thread's), so they run beside the main thread instead of behind it.
+//
+// Called at the start of the GC thread and of every Java thread. Elsewhere it does nothing.
+#include "Clearwing.h"
+
+#if defined(__SWITCH__)
+#include <switch.h>
+#include <atomic>
+#endif
+
+extern "C" void clearwingPlaceThread(void) {
+#if defined(__SWITCH__)
+    static std::atomic<unsigned> next{0};
+
+    s32 priority = 0x2C;
+    s32 mainCore = 0;
+    u64 mainMask = 0;
+    const Handle main = envGetMainThreadHandle();
+    if (R_FAILED(svcGetThreadPriority(&priority, main)))
+        priority = 0x2C;
+    if (R_FAILED(svcGetThreadCoreMask(&mainCore, &mainMask, main)))
+        mainCore = 0;
+
+    u64 allowed = 0;
+    if (R_FAILED(svcGetInfo(&allowed, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0)))
+        allowed = 0;
+    int cores[4];
+    int count = 0;
+    for (int core = 0; core < 4; core++)
+        if ((allowed & (1ull << core)) && core != mainCore)
+            cores[count++] = core;
+
+    (void)svcSetThreadPriority(CUR_THREAD_HANDLE, (u32)priority);
+    if (count > 0) {
+        const int core = cores[next.fetch_add(1) % (unsigned)count];
+        (void)svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1u << core);
+    }
+#endif
+}
