+// warsmash-nx: Java's min/max: NaN if either is NaN, and -0.0 < 0.0.
+extern "C++" {
+template <typename T>
+static T javaMax(T a, T b) {
+    if (a != a) return a;
+    if (b != b) return b;
+    if (a == 0 && b == 0) return std::signbit(a) ? b : a;
+    return a > b ? a : b;
+}
+
+template <typename T>
+static T javaMin(T a, T b) {
+    if (a != a) return a;
+    if (b != b) return b;
+    if (a == 0 && b == 0) return std::signbit(a) ? a : b;
+    return a < b ? a : b;
+}
+}
