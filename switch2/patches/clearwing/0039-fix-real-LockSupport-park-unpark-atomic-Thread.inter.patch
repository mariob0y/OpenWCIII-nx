+extern void lockSupportWakeContext(jcontext targetCtx);
+
+jbool SM_java_lang_Thread_interrupted_R_boolean(jcontext ctx) {
+    auto thread = ctx->thread;
+    if (!__atomic_load_n(&thread->F_interrupted, __ATOMIC_ACQUIRE))
+        return false;
+    return __atomic_exchange_n(&thread->F_interrupted, false, __ATOMIC_SEQ_CST);
+}
+
 void M_java_lang_Thread_interrupt(jcontext ctx, jobject self) {
     auto threadCtx = (jcontext) ((jthread) NULL_CHECK(self))->F_nativeContext;
+    if (!threadCtx)
+        return;
     threadCtx->lock.lock();
-    threadCtx->thread->F_interrupted = true;
+    __atomic_store_n(&threadCtx->thread->F_interrupted, true, __ATOMIC_SEQ_CST);
     if (jobject blocked = threadCtx->blockedBy.load())
         monitorWakeAllWaiters(getMonitor(blocked)); // warsmash-nx
+    lockSupportWakeContext(threadCtx); // warsmash-nx (round 12): wake LockSupport.park
     threadCtx->lock.unlock();
 }
 
