diff --git a/runtime/res/clearwing/src/PlatformThreads.cpp b/runtime/res/clearwing/src/PlatformThreads.cpp
index 41632e3..8e7afe6 100644
--- a/runtime/res/clearwing/src/PlatformThreads.cpp
+++ b/runtime/res/clearwing/src/PlatformThreads.cpp
@@ -104,3 +104,143 @@ void monitorWakeAllWaiters(jmonitor monitor) {
     monitor->notifySeq.fetch_add(1, std::memory_order_seq_cst);
     monitorFutexWake(monitor->notifySeq, -1);
 }
+
+// warsmash-nx (round 12): LockSupport.park* / unpark on top of monitorFutexWait/Wake (no-op park
+// caused AQS/BlockingQueue/ThreadPoolExecutor waiters to spin at 100% CPU and starve same-core
+// Horizon threads). Each ThreadContext gets a single 32-bit state word:
+//   bit 0     = permit available (1) or not (0)
+//   bits 1..31 = monotonic wake counter, bumped by both unpark (+2, setting bit 0) and interrupt /
+//                shutdown (+2, preserving bit 0) so svcWaitForAddress wakes immediately with zero
+//                lost wakeups.
+#include "java/lang/Thread.h"
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+
+namespace {
+std::mutex g_parkRegistryLock;
+std::unordered_map<jcontext, std::shared_ptr<std::atomic_uint32_t>> g_parkStates;
+
+std::shared_ptr<std::atomic_uint32_t> getParkState(jcontext ctx) {
+    std::lock_guard<std::mutex> guard(g_parkRegistryLock);
+    auto &slot = g_parkStates[ctx];
+    if (!slot)
+        slot = std::make_shared<std::atomic_uint32_t>(0);
+    return slot;
+}
+
+void lockSupportParkImpl(jcontext ctx, bool timed, int64_t timeoutNs) {
+    if (!ctx || !ctx->thread)
+        return;
+    auto state = getParkState(ctx);
+    // Fast path: permit already available.
+    if (state->load(std::memory_order_seq_cst) & 1u) {
+        state->fetch_and(~1u, std::memory_order_seq_cst);
+        return;
+    }
+    if (__atomic_load_n(&ctx->thread->F_interrupted, __ATOMIC_SEQ_CST))
+        return;
+    if (timed && timeoutNs <= 0)
+        return;
+
+    const auto deadline = timed
+            ? (std::chrono::steady_clock::now() + std::chrono::nanoseconds(timeoutNs))
+            : std::chrono::steady_clock::time_point{};
+
+    ctx->suspended = true;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    while (true) {
+        const uint32_t seen = state->load(std::memory_order_seq_cst);
+        if (seen & 1u) {
+            state->fetch_and(~1u, std::memory_order_seq_cst);
+            break;
+        }
+        if (__atomic_load_n(&ctx->thread->F_interrupted, __ATOMIC_SEQ_CST) || suspendVM)
+            break;
+        int64_t slice = 50000000; // 50 ms backstop; unpark/interrupt/shutdown wake at once
+        if (timed) {
+            const int64_t left = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    deadline - std::chrono::steady_clock::now()).count();
+            if (left <= 0)
+                break;
+            if (left < slice)
+                slice = left;
+        }
+        monitorFutexWait(*state, seen, slice);
+    }
+    ctx->suspended = false;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    SAFEPOINT();
+}
+} // namespace
+
+extern "C" {
+
+void lockSupportWakeContext(jcontext targetCtx) {
+    if (!targetCtx)
+        return;
+    std::shared_ptr<std::atomic_uint32_t> state;
+    {
+        std::lock_guard<std::mutex> guard(g_parkRegistryLock);
+        auto it = g_parkStates.find(targetCtx);
+        if (it == g_parkStates.end())
+            return;
+        state = it->second;
+    }
+    state->fetch_add(2u, std::memory_order_seq_cst);
+    monitorFutexWake(*state, 1);
+}
+
+void lockSupportDestroyContext(jcontext targetCtx) {
+    if (!targetCtx)
+        return;
+    std::shared_ptr<std::atomic_uint32_t> old;
+    {
+        std::lock_guard<std::mutex> guard(g_parkRegistryLock);
+        auto it = g_parkStates.find(targetCtx);
+        if (it != g_parkStates.end()) {
+            old = std::move(it->second);
+            g_parkStates.erase(it);
+        }
+    }
+    if (old) {
+        old->fetch_add(2u, std::memory_order_seq_cst);
+        monitorFutexWake(*old, -1);
+    }
+}
+
+void SM_java_util_concurrent_locks_LockSupport_unpark_java_lang_Thread(jcontext ctx, jobject threadObj) {
+    (void) ctx;
+    if (!threadObj)
+        return;
+    auto targetCtx = (jcontext) ((java_lang_Thread *) threadObj)->F_nativeContext;
+    if (!targetCtx)
+        return;
+    auto state = getParkState(targetCtx);
+    uint32_t cur = state->load(std::memory_order_seq_cst);
+    while (!state->compare_exchange_weak(cur, (cur + 2u) | 1u, std::memory_order_seq_cst)) {}
+    monitorFutexWake(*state, 1);
+}
+
+void SM_java_util_concurrent_locks_LockSupport_park(jcontext ctx) {
+    lockSupportParkImpl(ctx, false, 0);
+}
+
+void SM_java_util_concurrent_locks_LockSupport_parkNanos_long(jcontext ctx, jlong nanos) {
+    if (nanos > 0)
+        lockSupportParkImpl(ctx, true, (int64_t) nanos);
+}
+
+void SM_java_util_concurrent_locks_LockSupport_parkUntil_long(jcontext ctx, jlong deadlineMs) {
+    const int64_t nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+    const int64_t leftMs = (int64_t) deadlineMs - nowMs;
+    if (leftMs <= 0)
+        return;
+    const int64_t maxMs = INT64_MAX / 1000000LL;
+    const int64_t timeoutNs = (leftMs >= maxMs) ? INT64_MAX : (leftMs * 1000000LL);
+    lockSupportParkImpl(ctx, true, timeoutNs);
+}
+
+} // extern "C"
