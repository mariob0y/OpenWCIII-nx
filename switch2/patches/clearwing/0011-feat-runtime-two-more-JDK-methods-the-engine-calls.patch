From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mariob0y <suroviymarioboy@gmail.com>
Date: Mon, 23 Nov 2026 09:01:45 +0200
Subject: [PATCH 11/32] feat: runtime - two more JDK methods the engine calls

---
 runtime/build.gradle                       |  5 ++++-
 runtime/src/java/lang/System.java          |  8 ++++++++
 runtime/src/java/nio/MappedByteBuffer.java | 12 ++++++++++++
 3 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/runtime/build.gradle b/runtime/build.gradle
index fc6ccf4..80f8c37 100644
--- a/runtime/build.gradle
+++ b/runtime/build.gradle
@@ -1,7 +1,10 @@
 sourceCompatibility = 1.8
 targetCompatibility = 1.8
 // warsmash-nx: the runtime's own sources win over the JDK's classes (see jdk1.edits.py)
-tasks.withType(JavaCompile).configureEach { options.compilerArgs += ['-Xprefer:source'] }
+tasks.withType(JavaCompile).configureEach {
+    options.compilerArgs += ['-Xprefer:source']
+    options.incremental = false // all sources every time (see jdk1b.edits.py)
+}
 
 dependencies {
     implementation('com.github.tommyettinger:RegExodus:0.1.14')
diff --git a/runtime/src/java/lang/System.java b/runtime/src/java/lang/System.java
index 5133fac..38cb2ba 100644
--- a/runtime/src/java/lang/System.java
+++ b/runtime/src/java/lang/System.java
@@ -48,6 +48,14 @@ public final class System {
      */
     public static final java.io.PrintStream out = new PrintStream(new NativeOutputStream());
 
+    /** warsmash-nx: there is no standard input; reading it gives end of stream. */
+    public static final java.io.InputStream in = new java.io.InputStream() {
+        @Override
+        public int read() {
+            return -1;
+        }
+    };
+
     /**
      * Copies an array from the specified source array, beginning at the specified position, to the specified position of the destination array. A subsequence of array components are copied from the source array referenced by src to the destination array referenced by dst. The number of components copied is equal to the length argument. The components at positions srcOffset through srcOffset+length-1 in the source array are copied into positions dstOffset through dstOffset+length-1, respectively, of the destination array.
      * If the src and dst arguments refer to the same array object, then the copying is performed as if the components at positions srcOffset through srcOffset+length-1 were first copied to a temporary array with length components and then the contents of the temporary array were copied into positions dstOffset through dstOffset+length-1 of the destination array.
diff --git a/runtime/src/java/nio/MappedByteBuffer.java b/runtime/src/java/nio/MappedByteBuffer.java
index db9da58..ea590f8 100644
--- a/runtime/src/java/nio/MappedByteBuffer.java
+++ b/runtime/src/java/nio/MappedByteBuffer.java
@@ -6,4 +6,16 @@ public class MappedByteBuffer extends ByteBuffer {
 		super(0, 0);
 		throw new UnsupportedOperationException();
 	}
+
+	public final boolean isLoaded () { // warsmash-nx
+		return true;
+	}
+
+	public final MappedByteBuffer load () { // warsmash-nx
+		return this;
+	}
+
+	public final MappedByteBuffer force () { // warsmash-nx
+		return this;
+	}
 }
