diff --git a/runtime/res/clearwing/src/String.cpp b/runtime/res/clearwing/src/String.cpp
index 730d6a1..2421fad 100644
--- a/runtime/res/clearwing/src/String.cpp
+++ b/runtime/res/clearwing/src/String.cpp
@@ -6,6 +6,32 @@
 #include <cstring>
 #include <string>
 
+// warsmash-nx: Clearwing.cpp's decoder (malformed input -> U+FFFD).
+int decodeUtf8(const unsigned char *s, int length, char16_t *out);
+
+/// warsmash-nx: UTF-16 to UTF-8 as Java's encoder: a surrogate without its partner becomes '?'.
+static int encodeUtf8(const char16_t *s, int length, unsigned char *out) {
+    int count = 0;
+    auto put = [&](uint32_t b) { if (out) out[count] = (unsigned char) b; count++; };
+    for (int i = 0; i < length; i++) {
+        uint32_t c = s[i];
+        if (c >= 0xD800 && c <= 0xDBFF && i + 1 < length && s[i + 1] >= 0xDC00 && s[i + 1] <= 0xDFFF)
+            c = 0x10000 + ((c - 0xD800) << 10) + (s[++i] - 0xDC00);
+        else if (c >= 0xD800 && c <= 0xDFFF)
+            c = '?';
+        if (c < 0x80) {
+            put(c);
+        } else if (c < 0x800) {
+            put(0xC0 | c >> 6); put(0x80 | (c & 0x3F));
+        } else if (c < 0x10000) {
+            put(0xE0 | c >> 12); put(0x80 | (c >> 6 & 0x3F)); put(0x80 | (c & 0x3F));
+        } else {
+            put(0xF0 | c >> 18); put(0x80 | (c >> 12 & 0x3F)); put(0x80 | (c >> 6 & 0x3F)); put(0x80 | (c & 0x3F));
+        }
+    }
+    return count;
+}
+
