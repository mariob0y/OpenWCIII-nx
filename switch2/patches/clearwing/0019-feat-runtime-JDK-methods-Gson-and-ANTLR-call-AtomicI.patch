diff --git a/runtime/src/java/lang/Class.java b/runtime/src/java/lang/Class.java
index 6842443..3ab6354 100644
--- a/runtime/src/java/lang/Class.java
+++ b/runtime/src/java/lang/Class.java
@@ -547,6 +547,30 @@ public final class Class<T> implements java.lang.reflect.Type {
         return interfaces;
     }
 
+    /** warsmash-nx: the raw superclass (no class signatures in this runtime; see jdk2.edits.py). */
+    public java.lang.reflect.Type getGenericSuperclass() {
+        return getSuperclass();
+    }
+
+    /**
+     * warsmash-nx: the class named before the last '$' (member, local and anonymous classes), null
+     * for a top-level class. The runtime keeps no InnerClasses attribute, so a top-level class whose
+     * own name contains '$' is misreported.
+     */
+    public Class<?> getEnclosingClass() {
+        if (isArray() || isPrimitive())
+            return null;
+        String n = getName();
+        int index = n.lastIndexOf('$');
+        if (index <= 0)
+            return null;
+        try {
+            return Class.forName(n.substring(0, index));
+        } catch (ClassNotFoundException e) {
+            return null;
+        }
+    }
+
     public java.lang.reflect.Type[] getGenericInterfaces() {
