 //        return this; 
 //    }
 
+    /** warsmash-nx: as the JDK (a supplementary code point appends its surrogate pair). */
+    public java.lang.StringBuilder appendCodePoint(int codePoint) {
+        if (Character.isBmpCodePoint(codePoint))
+            return append((char) codePoint);
+        if (!Character.isValidCodePoint(codePoint))
+            throw new IllegalArgumentException(String.format("Not a valid Unicode code point: 0x%X", codePoint));
+        append(Character.highSurrogate(codePoint));
+        return append(Character.lowSurrogate(codePoint));
+    }
