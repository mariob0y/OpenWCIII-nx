From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mariob0y <suroviymarioboy@gmail.com>
Date: Mon, 23 Nov 2026 09:01:56 +0200
Subject: [PATCH 31/32] perf: runtime - ByteBuffer bulk byte[] get/put in one
 copy

---
 runtime/src/java/nio/ByteBuffer.java | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/runtime/src/java/nio/ByteBuffer.java b/runtime/src/java/nio/ByteBuffer.java
index 8e454db..736289f 100644
--- a/runtime/src/java/nio/ByteBuffer.java
+++ b/runtime/src/java/nio/ByteBuffer.java
@@ -151,9 +151,11 @@ public class ByteBuffer extends Buffer implements Comparable<ByteBuffer> {
 		checkBounds(offset, length, dst.length);
 		if (length > remaining())
 			throw new BufferUnderflowException();
-		int end = offset + length;
-		for (int i = offset; i < end; i++)
-			dst[i] = get();
+		// warsmash-nx (round 9): one copy, not a checked get() per byte
+		final int start = position();
+		if (length > 0)
+			NativeUtils.copyMemory(ix(start), NativeUtils.getArrayAddress(dst) + offset, length);
+		position(start + length);
 		return this;
 	}
 
@@ -178,9 +180,11 @@ public class ByteBuffer extends Buffer implements Comparable<ByteBuffer> {
 		checkBounds(offset, length, src.length);
 		if (length > remaining())
 			throw new BufferOverflowException();
-		int end = offset + length;
-		for (int i = offset; i < end; i++)
-			this.put(src[i]);
+		// warsmash-nx (round 9): one copy, not a checked put(byte) per byte
+		final int start = position();
+		if (length > 0)
+			NativeUtils.copyMemory(NativeUtils.getArrayAddress(src) + offset, ix(start), length);
+		position(start + length);
 		return this;
 	}
 
